{
  "name": "chessroot",
  "version": "1.7.0-dev.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "ng build",
    "build:release": "ng build --configuration production && yarn sentry:release:new && yarn sentry:sourcemaps:inject && yarn sentry:sourcemaps:upload && yarn sentry:sourcemaps:clean",
    "cz": "cz",
    "deploy": "yarn build:release && wrangler deploy --env production && yarn sentry:release:finalize",
    "deploy:dev": "yarn build:release && wrangler deploy --env development && yarn sentry:release:finalize",
    "e2e": "playwright test",
    "e2e:debug": "cross-env E2E=true DEBUG=true playwright test --debug",
    "lint": "yarn eslint . --ext .ts",
    "ng": "ng",
    "prepare": "husky",
    "prettier": "prettier --write .",
    "release": "standard-version && git push --follow-tags",
    "release:dev": "standard-version --prerelease dev && git push --follow-tags",
    "start": "ng serve",
    "test": "ng test",
    "test:coverage": "ng test --coverage",
    "test:ui": "ng test --ui",
    "sentry:release:new": "sentry-cli releases new $SENTRY_RELEASE --org pawe-gawlik --project chessroot",
    "sentry:release:finalize": "sentry-cli releases finalize $SENTRY_RELEASE --org pawe-gawlik --project chessroot",
    "sentry:sourcemaps:inject": "sentry-cli sourcemaps inject --org pawe-gawlik --project chessroot ./dist/chessroot/browser",
    "sentry:sourcemaps:upload": "sentry-cli sourcemaps upload --org pawe-gawlik --project chessroot --release $SENTRY_RELEASE ./dist/chessroot/browser",
    "sentry:sourcemaps:clean": "node scripts/delete-sourcemaps.mjs ./dist/chessroot/browser"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix"
    ],
    "*.{ts,html,json,yml,yaml,md,css,scss}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-customizable"
    }
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@angular-architects/ngrx-toolkit": "22.0.0",
    "@angular/cdk": "22.2.1",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/material": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/platform-server": "22.2.1",
    "@angular/router": "22.2.1",
    "@bity/oauth2-auth-code-pkce": "2.13.0",
    "@mliebelt/pgn-parser": "1.4.19",
    "@mliebelt/pgn-types": "1.0.4",
    "@ngrx/effects": "22.0.1",
    "@ngrx/signals": "22.0.1",
    "@sentry/angular": "^11.4.0",
    "@sentry/cli": "^3.8.0",
    "chart.js": "4.5.1",
    "chess.js": "1.4.0",
    "chessground": "9.2.1",
    "chessops": "0.15.1",
    "date-fns": "4.4.0",
    "express": "5.2.1",
    "fzstd": "0.1.1",
    "jasmine-marbles": "0.9.2",
    "jszip": "3.10.2",
    "ngx-chessground": "22.7.0",
    "rxjs": "~7.8.2",
    "snabbdom": "3.6.4",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.8.0",
    "@analogjs/vitest-angular": "2.8.0",
    "@angular-devkit/architect": "0.2202.1",
    "@angular-devkit/build-angular": "22.2.1",
    "@angular-devkit/core": "22.2.1",
    "@angular-eslint/eslint-plugin": "22.5.0",
    "@angular-eslint/eslint-plugin-template": "22.5.0",
    "@angular-eslint/template-parser": "22.5.0",
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@angular/language-server": "22.1.8",
    "@angular/material": "22.2.1",
    "@angular/platform-browser-dynamic": "22.2.1",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@compodoc/compodoc": "2.0.0",
    "@eslint/js": "10.0.1",
    "@ngrx/store": "22.0.1",
    "@ngrx/store-devtools": "22.0.1",
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/ui": "5.0.3",
    "angular-eslint": "22.5.0",
    "canvas": "3.2.3",
    "commitizen": "4.3.2",
    "cross-env": "10.1.0",
    "cz-customizable": "^7.5.4",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-unused-imports": "4.4.1",
    "husky": "9.1.7",
    "jsdom": "30.1.1",
    "lint-staged": "17.6.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "prettier-eslint": "17.1.2",
    "standard-version": "9.5.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3",
    "wrangler": "4.147.0"
  },
  "packageManager": "yarn@4.17.1",
  "standard-version": {
    "scripts": {
      "postchangelog": "prettier --write CHANGELOG.md"
    }
  }
}
